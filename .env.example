# MNQ Futures AutoScalper Environment Configuration

# Interactive Brokers
IBKR_HOST=127.0.0.1
IBKR_PORT=4002  # 4002 = Gateway paper, 4001 = Gateway live
IBKR_CLIENT_ID=1

# TradingView Webhook
TRADINGVIEW_WEBHOOK_SECRET=your_webhook_secret_here
TRADINGVIEW_WEBHOOK_PORT=8080

# Risk Parameters (dollar-based for futures)
ACCOUNT_BALANCE=10000
DAILY_MAX_LOSS=500        # Stop trading if down $500
MAX_LOSS_STREAK=3         # Stop after 3 consecutive losses

# Position Sizing
# NUM_CONTRACTS > 0: fixed number of contracts per position
# NUM_CONTRACTS = 0: auto-calculate based on account balance and margin
NUM_CONTRACTS=1
MARGIN_PER_CONTRACT=2000  # Fallback if IBKR margin fetch fails
MARGIN_BUFFER=0.80        # Safety buffer: only use 80% of balance for margin

# IBKR Maintenance Window (UTC) - trading disabled during this time
# IB Gateway restarts at 11:45 PM PT daily (configured in docker-compose.yml)
# 11 PM - 1 AM PT = 06:00-09:00 UTC (covers both PST and PDT)
MAINTENANCE_START=06:00
MAINTENANCE_END=09:00

# Mode (DRY_RUN=true means no IBKR connection, just simulated trades)
DRY_RUN=true

# Telegram Notifications (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
